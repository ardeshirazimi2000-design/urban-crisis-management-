# Local development only — never commit real values. Production secrets come from Vault/KMS.
APP_ENV=local
POSTGRES_PASSWORD=local-only
DEV_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
MEDIA_URL_SECRET=change-me-local-media-secret-at-least-32-chars
# Where the console is published. Use 0.0.0.0:80 to serve the office LAN.
WEB_BIND=127.0.0.1:8081
PUBLIC_BASE_URL=http://localhost:8081
# Package mirrors (override where the defaults are unreachable)
GOPROXY=https://proxy.golang.org,direct
NPM_REGISTRY=https://registry.npmjs.org/
PIP_INDEX_URL=https://pypi.org/simple
