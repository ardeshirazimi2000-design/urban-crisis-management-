{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.scored.v1.json",
  "title": "report.scored v1",
  "description": "Non-authoritative AI signal. Never changes review decisions.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "report.scored"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "report_id",
        "model_version",
        "status"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ]
        },
        "predicted_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_confidence": {
          "type": [
            "number",
            "null"
          ],
          "description": "share of matched evidence, NOT probability of truth"
        },
        "urgency_signal": {
          "type": [
            "number",
            "null"
          ]
        },
        "signals": {
          "type": "object"
        }
      }
    }
  }
}