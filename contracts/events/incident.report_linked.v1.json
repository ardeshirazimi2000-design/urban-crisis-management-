        "report_id"
      ],
      "properties": {
        "incident_id": {
          "type": "string",
          "format": "uuid"
        },
        "report_id": {
          "type": "string",
          "format": "uuid"
        },
        "relation_type": {
          "type": "string"
        }
      }
    }
  }
}