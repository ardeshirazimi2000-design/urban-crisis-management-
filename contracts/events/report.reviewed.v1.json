{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.reviewed.v1.json",
  "title": "report.reviewed v1",
  "description": "Human review decision.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "report.reviewed"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "report_id",
        "decision"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected",
            "duplicate"
          ]
        },
        "reason_given": {
          "type": "boolean"
        },
        "severity": {
          "type": "string"
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}