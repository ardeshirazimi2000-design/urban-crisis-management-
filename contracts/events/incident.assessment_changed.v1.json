{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident.assessment_changed.v1.json",
  "title": "incident.assessment_changed v1",
  "description": "Severity / response level changed.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "incident.assessment_changed"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "to_severity",
        "to_level",
        "reason"
      ],
      "properties": {
        "from_severity": {
          "type": "string"
        },
        "to_severity": {
          "type": "string"
        },
        "from_level": {
          "type": "string"
        },
        "to_level": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}