{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.v1.json",
  "title": "Event envelope v1",
  "description": "Common envelope for every event. Delivery is at-least-once; consumers must de-duplicate by event_id (inbox). Ordering is guaranteed only per aggregate (Kafka key = aggregate.id). Topic = <prefix><event_type>.v<schema_version>.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate",
    "occurred_at",
    "producer",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_]+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}