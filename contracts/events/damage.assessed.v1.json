{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "damage.assessed.v1.json",
  "title": "damage.assessed v1",
  "description": "A rapid building assessment (or a re-inspection superseding an earlier one).",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "damage.assessed"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "assessment_id",
        "tag",
        "building_use",
        "people_trapped",
        "location"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "format": "uuid"
        },
        "incident_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "tag": {
          "type": "string",
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "building_use": {
          "type": "string"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "people_trapped": {
          "type": "boolean"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "location": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
