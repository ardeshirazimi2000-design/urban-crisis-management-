{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alert.approved.v1.json",
  "title": "alert.approved v1",
  "description": "Approved (four-eyes). Notification may now be dispatched.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "alert.approved"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "alert_id",
        "mode",
        "channels",
        "expires_at"
      ],
      "properties": {
        "alert_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "enum": [
            "test",
            "operational"
          ]
        },
        "severity": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by": {
          "type": "string",
          "format": "uuid"
        },
        "incident_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}