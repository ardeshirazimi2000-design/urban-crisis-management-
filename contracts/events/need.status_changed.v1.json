{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "need.status_changed.v1.json",
  "title": "need.status_changed v1",
  "description": "Supply recorded against a need, or the need was cancelled.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "need.status_changed"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "need_id",
        "incident_id",
        "change",
        "status",
        "quantity",
        "fulfilled"
      ],
      "properties": {
        "need_id": {
          "type": "string",
          "format": "uuid"
        },
        "incident_id": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "type": "string"
        },
        "change": {
          "type": "string",
          "enum": [
            "fulfilled",
            "cancelled"
          ]
        },
        "from": {
          "type": "string",
          "enum": [
            "open",
            "partially_met",
            "met",
            "cancelled"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "partially_met",
            "met",
            "cancelled"
          ]
        },
        "quantity": {
          "type": "integer"
        },
        "fulfilled": {
          "type": "integer"
        }
      }
    }
  }
}
